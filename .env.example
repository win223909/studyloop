# Copy to .env. This template contains no working credentials.
# 完整操作说明 / Full guide: docs/configuration.md
# 45 个服务与区域预设 / 45 service and region presets: docs/model-providers.md
# 本机“模型与设置”可搜索分组；模型 ID 自填，目录不代表逐模型实测。
HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
# Optional private GUI settings file. Default: project .env. Parent must be writable.
# Example for a private directory: SETTINGS_FILE=./private-settings/settings.env
SETTINGS_FILE=

# Model protocol: openai-compatible | anthropic | gemini
# Choose the matching account/region; local and international entries are separate.
# Set the exact API root from the directory (do not add endpoint paths), model ID,
# and YOUR OWN API key. Never commit .env or put keys in VITE_* variables.
# 留空即可体验内置课程；任意课程生成需填写自己的模型配置。
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_REVIEW_MODEL=
LLM_ALLOW_KEYLESS=false
LLM_TIMEOUT_MS=90000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_JSON_MODE=false
# auto: official OpenAI uses max_completion_tokens; other compatible APIs max_tokens.
# Copy preset overrides when configuring manually; see docs/model-providers.md.
# MiniMax, SenseCore and Azure presets use max_completion_tokens.
LLM_TOKEN_PARAMETER=auto

# Default keyword search: Wikipedia, no key. Optional Brave Search key.
BRAVE_SEARCH_API_KEY=

# The bundled OpenMAIC classroom reuses this model configuration.
# No external classroom URL or second API key is required.

# Browser speech uses system/browser voices. Cloud TTS is not included in v0.1.
# Use an instance password when sharing a deployment. Keep it private.
INSTANCE_PASSWORD=
COOKIE_SECURE=false
TRUST_PROXY=0

# Shared daily cap: one plan, question-bank or classroom generation request uses one unit.
# A classroom uses multiple requests (commonly two per scene), not one unit per course.
# A request can involve multiple model calls. Failed requests still count.
DAILY_GENERATION_LIMIT=20
MAX_CONCURRENT_GENERATIONS=2
